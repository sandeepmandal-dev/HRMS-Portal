# Copy this file to .env and fill in real values for local/dev use.
DB_URL=jdbc:postgresql://localhost:5432/hrms_db
DB_USERNAME=hrms_user
DB_PASSWORD=hrms_password

JWT_SECRET=replace-with-a-long-random-256-bit-secret
JWT_ACCESS_EXPIRY=3600000
JWT_REFRESH_EXPIRY=604800000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
